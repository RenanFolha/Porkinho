rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /locais/{localId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.membros;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.membros;

      // edição normal por quem já é membro
      allow update: if request.auth != null && request.auth.uid in resource.data.membros;

      // entrada por convite: quem ainda não é membro só pode se adicionar
      // se a escrita vier acompanhada de um token de convite válido para este Local
      allow update: if request.auth != null
        && request.resource.data.membros.hasAll(resource.data.membros)
        && request.resource.data.membros.size() == resource.data.membros.size() + 1
        && request.auth.uid in request.resource.data.membros
        && exists(/databases/$(database)/documents/convites/$(request.resource.data.conviteAtual))
        && get(/databases/$(database)/documents/convites/$(request.resource.data.conviteAtual)).data.localId == localId;
    }

    match /convites/{token} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/locais/$(request.resource.data.localId)).data.membros;
      allow list, update, delete: if false;
    }
  }
}
